<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.ictedu.someta.member.LoginDao">

	<!-- Login Check -->
	<select id="checkPassword" parameterType="mem" resultType="mem">
		SELECT id, pwd, regdate
		FROM MEMBER
		WHERE id = #{id} AND pwd = #{pwd}
	</select>

	<!-- Search for User Information -->
	<select id="getUserInfo" parameterType="mem" resultType="mem">
		SELECT id, pwd, regdate
		FROM MEMBER
		WHERE id = #{id}
	</select>

	<!-- Password Change -->
	<update id="changepw">
		UPDATE MEMBER
		SET pwd = #{pwd}
		WHERE id = #{id}
	</update>
</mapper>
